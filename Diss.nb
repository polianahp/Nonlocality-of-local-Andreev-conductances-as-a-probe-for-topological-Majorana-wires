Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"GetVdis", ",", "Vdk", ",", "VdkQ", ",", " ", "GetVd"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GetVdis", ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vdk", ",", "ii", ",", "jj", ",", " ", "vtpx", ",", "vtp", ",", " ", 
       "sum", ",", " ", "v2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vdk", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "*", 
          RowBox[{"Qdis", "[", 
           RowBox[{"[", "ii", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vtp", "=", 
       RowBox[{"\[Psi]kx", ".", "vdk"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sum", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"vtp", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}], "/", "Nx"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"vtp", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vtp", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], "-", "sum"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v2", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vtp", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}], "/", "Nx"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"vtp", "/", 
       SqrtBox["v2"]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vdk", ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VdkQ", "[", "vdk_", "]"}], ":=", 
   RowBox[{"vdk", "*", "Qdis"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GetVd", "[", "vdk_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ii", ",", "jj", ",", " ", "vtpx", ",", "vtp", ",", " ", "sum", ",", 
       " ", "v2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vtpx", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vtp", "=", 
       RowBox[{"\[Psi]kx", ".", "vdk"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sum", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"vtp", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}], "/", "Nx"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"vtp", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vtp", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], "-", "sum"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v2", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vtp", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}], "/", "Nx"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"vtp", "/", 
       SqrtBox["v2"]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
