Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"Nx", ",", "Qdis", ",", "Vn", ",", "\[Lambda]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", "9.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", "4.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", "9.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nx", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]kx", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"Nx", "+", "1.0"}], ")"}]}]], "*", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"ii", "*", "nn", "*", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"Nx", "+", "1.0"}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"nn", ",", "1", ",", "Nx"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vn", "[", "vds_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"vds", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "1", ",", 
             RowBox[{"Length", "[", "vds", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vds", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", 
            RowBox[{"Length", "[", "vds", "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vds", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "^", "3"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", 
            RowBox[{"Length", "[", "vds", "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vds", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "^", "4"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", 
            RowBox[{"Length", "[", "vds", "]"}]}], "}"}]}], "]"}]}], "}"}], "/", 
      RowBox[{"Length", "[", "vds", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qdis", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tanh", "[", 
       RowBox[{"ii", "/", "2"}], "]"}], "*", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"ii", "^", "2"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"4", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Nx", "^", "2"}], ")"}], "/", 
           RowBox[{"\[Lambda]", "^", "2"}]}]}], ")"}]}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";"}]}], "Input",
