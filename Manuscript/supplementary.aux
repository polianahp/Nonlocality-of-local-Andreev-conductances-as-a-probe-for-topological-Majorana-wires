\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Discrimination between topological Majorana zero modes and trivial quasi-Majoranas via bilateral cross-gate differential reflectometry.} (a) Spatial probability density $|\Psi (x)|^2$ along a $3.5\,\mu \mathrm  {m}$ nanowire. True topological MZMs (solid green) exhibit bilateral boundary modes localized at opposite wire ends ($x=0$ and $x=L$) with exponential overlap suppression ($\delta E \sim e^{-L/\xi }$). Trivial quasi-Majoranas (partially separated Andreev bound states, dashed red) feature two constituent Majoranas localized at the same end of the wire ($x \le 0.5\,\mu \mathrm  {m}$) with zero amplitude at the opposite cutter gate. (b) Differential reflectometry response $\partial C_{Q,L} / \partial V_{\mathrm  {wc},R}$ as a function of right cutter gate sweep $\Delta V_{\mathrm  {wc},R}$. While local or flux-dependent capacitance oscillations can be mimicked by quasi-Majoranas~\cite  {Stanescu2026}, cross-gate differential coupling collapses to zero for trivial states ($|\partial C_{Q,L}/\partial V_{\mathrm  {wc},R}| \approx 0$, dotted red), surviving exclusively for topological MZMs with bilateral end-to-end support (solid green).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:s3_stanescu_filter}{{S3}{4}{\textbf {Discrimination between topological Majorana zero modes and trivial quasi-Majoranas via bilateral cross-gate differential reflectometry.} (a) Spatial probability density $|\Psi (x)|^2$ along a $3.5\,\mu \mathrm {m}$ nanowire. True topological MZMs (solid green) exhibit bilateral boundary modes localized at opposite wire ends ($x=0$ and $x=L$) with exponential overlap suppression ($\delta E \sim e^{-L/\xi }$). Trivial quasi-Majoranas (partially separated Andreev bound states, dashed red) feature two constituent Majoranas localized at the same end of the wire ($x \le 0.5\,\mu \mathrm {m}$) with zero amplitude at the opposite cutter gate. (b) Differential reflectometry response $\partial C_{Q,L} / \partial V_{\mathrm {wc},R}$ as a function of right cutter gate sweep $\Delta V_{\mathrm {wc},R}$. While local or flux-dependent capacitance oscillations can be mimicked by quasi-Majoranas~\cite {Stanescu2026}, cross-gate differential coupling collapses to zero for trivial states ($|\partial C_{Q,L}/\partial V_{\mathrm {wc},R}| \approx 0$, dotted red), surviving exclusively for topological MZMs with bilateral end-to-end support (solid green)}{figure.3}{}}
