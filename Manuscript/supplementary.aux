\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Analytical transfer-matrix recurrence and numerical Kwant parity verification.} (a) Normal transmission probability $T_N(U_b)$ across a rectangular barrier ($L_b = 3$ sites, $t = 16.529\,\mathrm  {meV}$, $\mu _{\mathrm  {leads}} = t$, probe bias $E = 0.5\,\mathrm  {meV}$) comparing the exact analytical transfer-matrix recurrence (Eq.~\eqref  {eq:transfer_solve}, solid blue line) and the numerical Kwant scattering matrix (dashed red line). (b) Absolute numerical discrepancy $|T_{\mathrm  {Kwant}} - T_{\mathrm  {analytic}}|$ on a logarithmic scale, proving machine-precision parity ($< 10^{-14}$) across the entire parameter bracket $[-3.0, 10.0]\,\mathrm  {meV}$.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:s1_parity}{{S1}{2}{\textbf {Analytical transfer-matrix recurrence and numerical Kwant parity verification.} (a) Normal transmission probability $T_N(U_b)$ across a rectangular barrier ($L_b = 3$ sites, $t = 16.529\,\mathrm {meV}$, $\mu _{\mathrm {leads}} = t$, probe bias $E = 0.5\,\mathrm {meV}$) comparing the exact analytical transfer-matrix recurrence (Eq.~\eqref {eq:transfer_solve}, solid blue line) and the numerical Kwant scattering matrix (dashed red line). (b) Absolute numerical discrepancy $|T_{\mathrm {Kwant}} - T_{\mathrm {analytic}}|$ on a logarithmic scale, proving machine-precision parity ($< 10^{-14}$) across the entire parameter bracket $[-3.0, 10.0]\,\mathrm {meV}$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Destruction of non-local transport conductance in realistic disordered nanowires.} (a) Decay of non-local conductance $|G_{LR}|$ as a function of wire length $L$ for clean nanowires ($\xi \approx 0.50\,\mu \mathrm  {m}$, blue) and realistic disordered nanowires ($V_0 = 1.2\,\mathrm  {meV}$, red). Shaded area denotes standard experimental device lengths ($L \ge 3\,\mu \mathrm  {m}$). Dashed horizontal line marks the experimental noise floor ($10^{-4}\,e^2/h \approx 3.87\,\mathrm  {nS}$). (b) Fraction of the topological phase quenched below the experimental noise floor evaluated across an ensemble of 40 disordered wire realizations for disorder strengths $V_0 \in \{0.378, 0.645, 0.872, 1.2\}\,\mathrm  {meV}$, demonstrating that $77\%\text  {--}92\%$ of genuine topological states produce no detectable non-local transport signal.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:s2_quenching}{{S2}{2}{\textbf {Destruction of non-local transport conductance in realistic disordered nanowires.} (a) Decay of non-local conductance $|G_{LR}|$ as a function of wire length $L$ for clean nanowires ($\xi \approx 0.50\,\mu \mathrm {m}$, blue) and realistic disordered nanowires ($V_0 = 1.2\,\mathrm {meV}$, red). Shaded area denotes standard experimental device lengths ($L \ge 3\,\mu \mathrm {m}$). Dashed horizontal line marks the experimental noise floor ($10^{-4}\,e^2/h \approx 3.87\,\mathrm {nS}$). (b) Fraction of the topological phase quenched below the experimental noise floor evaluated across an ensemble of 40 disordered wire realizations for disorder strengths $V_0 \in \{0.378, 0.645, 0.872, 1.2\}\,\mathrm {meV}$, demonstrating that $77\%\text {--}92\%$ of genuine topological states produce no detectable non-local transport signal}{figure.2}{}}
