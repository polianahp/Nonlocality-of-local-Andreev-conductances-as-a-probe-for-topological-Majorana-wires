\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Modern InAs--Pb platform electrostatics, Majorana decoupling, and dispersive RF reflectometry sensing.} (a) Above-gap normal conductance $G_N(U)$ at $E_{\mathrm  {calib}} = 2.0\,\mathrm  {meV} > \Delta _0$ for clean wire and Realization 0 ($V_0 = 1.2\,\mathrm  {meV}$), demonstrating strictly monotonic repulsive operation ($U \in [2.0, 10.5]\,\mathrm  {meV}$) and complete elimination of attractive-well turnaround. (b) 1D Zeeman field cut for Realization 0 ($L = 3.5\,\mu \mathrm  {m}$, $\mu = 0.50\,\mathrm  {meV}$), showing bulk gap closure at $V_c = 0.95\,\mathrm  {meV}$, sub-$\mu \mathrm  {eV}$ Majorana pinning ($E_0 < 1\,\mu \mathrm  {eV}$), and boundary confinement jump ($\mathcal  {C} = 0.02 \to 0.79$). (c) Dispersive RF reflectometry quantum capacitance cross-correlation architecture on floating tetron geometries.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:inas_pb}{{3}{4}{\textbf {Modern InAs--Pb platform electrostatics, Majorana decoupling, and dispersive RF reflectometry sensing.} (a) Above-gap normal conductance $G_N(U)$ at $E_{\mathrm {calib}} = 2.0\,\mathrm {meV} > \Delta _0$ for clean wire and Realization 0 ($V_0 = 1.2\,\mathrm {meV}$), demonstrating strictly monotonic repulsive operation ($U \in [2.0, 10.5]\,\mathrm {meV}$) and complete elimination of attractive-well turnaround. (b) 1D Zeeman field cut for Realization 0 ($L = 3.5\,\mu \mathrm {m}$, $\mu = 0.50\,\mathrm {meV}$), showing bulk gap closure at $V_c = 0.95\,\mathrm {meV}$, sub-$\mu \mathrm {eV}$ Majorana pinning ($E_0 < 1\,\mu \mathrm {eV}$), and boundary confinement jump ($\mathcal {C} = 0.02 \to 0.79$). (c) Dispersive RF reflectometry quantum capacitance cross-correlation architecture on floating tetron geometries}{figure.3}{}}
