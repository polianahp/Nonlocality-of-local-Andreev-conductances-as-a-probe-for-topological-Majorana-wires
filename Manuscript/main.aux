\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Contact impurity backscattering, attractive well turnaround, and spatial asymmetry invariance.} (a) Normal-state differential conductance $G_N$ as a function of cutter potential $U$ at bias $E = 0.5\,\text  {meV} > \Delta _0$. In a clean wire (blue), transmission increases monotonically into the attractive well regime ($U < 0$). Under disorder ($V_0 = 1.2\,\text  {meV}$, dashed curves), strong contact backscattering limits peak transmission on Lead R to $G_{RR} \le 0.7103\,e^2/h$ (red dot). Further deepening the well causes Fabry-P\'erot reflections and conductance turnaround ($0.71 \to 0.55\,e^2/h$). Shaded gray denotes the calibrated target window $G_N \in [0.25, 0.65]\,e^2/h$. (b) Calibrated gate potential asymmetry $\Delta U^* = U_L^* - U_R^*$ across target conductances $G_N^*$ for Realizations 0 through 4, demonstrating rigid, target-invariant spatial asymmetry across the ensemble.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:barrier_turnaround}{{1}{2}{\textbf {Contact impurity backscattering, attractive well turnaround, and spatial asymmetry invariance.} (a) Normal-state differential conductance $G_N$ as a function of cutter potential $U$ at bias $E = 0.5\,\text {meV} > \Delta _0$. In a clean wire (blue), transmission increases monotonically into the attractive well regime ($U < 0$). Under disorder ($V_0 = 1.2\,\text {meV}$, dashed curves), strong contact backscattering limits peak transmission on Lead R to $G_{RR} \le 0.7103\,e^2/h$ (red dot). Further deepening the well causes Fabry-P\'erot reflections and conductance turnaround ($0.71 \to 0.55\,e^2/h$). Shaded gray denotes the calibrated target window $G_N \in [0.25, 0.65]\,e^2/h$. (b) Calibrated gate potential asymmetry $\Delta U^* = U_L^* - U_R^*$ across target conductances $G_N^*$ for Realizations 0 through 4, demonstrating rigid, target-invariant spatial asymmetry across the ensemble}{figure.1}{}}
