\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Topological phase classification comparison on Realization 2 ($V_0 = 1.2\,\mathrm  {meV}$, $225 \times 70$ grid).} Top Left: Microsoft TGP Stage 2 baseline exhibits extensive false positive clusters in the trivial regime ($\mathrm  {FDR} = 17.21\%$). Top Right: Uncalibrated gate voltage sweeps suffer complete signal extinction ($\mathrm  {TPR} = 0\%$, $0\,\text  {px}$). Bottom Left: Calibrated conductance-space correlation on Lead R ($\theta = 0.80$, $G_N^* = 0.55\,e^2/h$) eliminates extinction, recovering 133 topological pixels and halving the FDR to $8.90\%$. Bottom Right: Calibrated correlation requiring bilateral consensus ($\min (L, R) \ge 0.80$) slashes false positives to just 7 pixels ($\mathrm  {FPR} = 0.05\%$). Dashed black contours indicate ground-truth Pfaffian boundaries ($\mathcal  {Q} = -1$).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:phase_maps}{{2}{3}{\textbf {Topological phase classification comparison on Realization 2 ($V_0 = 1.2\,\mathrm {meV}$, $225 \times 70$ grid).} Top Left: Microsoft TGP Stage 2 baseline exhibits extensive false positive clusters in the trivial regime ($\mathrm {FDR} = 17.21\%$). Top Right: Uncalibrated gate voltage sweeps suffer complete signal extinction ($\mathrm {TPR} = 0\%$, $0\,\text {px}$). Bottom Left: Calibrated conductance-space correlation on Lead R ($\theta = 0.80$, $G_N^* = 0.55\,e^2/h$) eliminates extinction, recovering 133 topological pixels and halving the FDR to $8.90\%$. Bottom Right: Calibrated correlation requiring bilateral consensus ($\min (L, R) \ge 0.80$) slashes false positives to just 7 pixels ($\mathrm {FPR} = 0.05\%$). Dashed black contours indicate ground-truth Pfaffian boundaries ($\mathcal {Q} = -1$)}{figure.2}{}}
